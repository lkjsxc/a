{
  "name": "a-study-documents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node site/build.ts",
    "preview": "node site/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test site/tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build && node site/check.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/sanitize-html": "2.16.2",
    "csv-parse": "7.0.3",
    "github-slugger": "2.0.0",
    "linkedom": "0.18.13",
    "marked": "18.0.14",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
